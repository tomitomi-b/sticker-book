{
  "name": "sticker-book",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev public --d1=DB=sticker-book-db",
    "deploy": "wrangler pages deploy public",
    "db:create": "wrangler d1 create sticker-book-db",
    "db:migrate": "wrangler d1 execute sticker-book-db --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute sticker-book-db --local --file=./schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
